# gsc-wp 本地部署环境变量示例（复制为 .env）

# ---- Google Search Console ----
# 服务账号密钥 JSON 路径
GSC_KEY_FILE=./service_account.json
# 站点属性（与 GSC 后台一致）：sc-domain:example.com 或 https://example.com/
GSC_SITE_URL=https://www.example.com/
# 访问 Google 的代理（国内环境，可选）：socks5 或 http
# GSC_SOCKS_PROXY=socks5://127.0.0.1:10808
GSC_LANGUAGE_CODE=en-US
GSC_TIMEOUT_MS=30000

# ---- WordPress ----
WP_SITE_URL=https://www.example.com
WP_USERNAME=
WP_APP_PASSWORD=
WP_TIMEOUT_MS=30000

# ---- WooCommerce（可选，用于 wp_get_woo_products 完整字段）----
# WOO_CONSUMER_KEY=ck_xxxxxxxx
# WOO_CONSUMER_SECRET=cs_xxxxxxxx

# ---- 写入总开关（默认 false=只读）----
WP_ALLOW_WRITE=false

# ---- HTTP 模式（本地/远程）----
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8801
MCP_SERVERS=all,gsc,wordpress,seo
# MCP_AUTH_TOKEN=change-me
